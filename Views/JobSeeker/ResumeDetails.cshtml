@using AI_powerd_job_search_management_system.Models

@{
    ViewData["Title"] = "Education & Experience";

    var resume = (Resume)ViewBag.Resume;

    var educations = ViewBag.Educations as List<Education>
        ?? new List<Education>();

    var experiences = ViewBag.Experiences as List<Experience>
        ?? new List<Experience>();

    var certifications = ViewBag.Certifications as List<Certification>
        ?? new List<Certification>();

    var projects = ViewBag.Projects as List<Project>
        ?? new List<Project>();

    var activities = ViewBag.Activities as List<ExtracurricularActivity>
        ?? new List<ExtracurricularActivity>();
}

<div class="page-header">
    <h2>Education & Experience</h2>
    <p>
        Manage your education, experience, certifications,
        projects and extracurricular activities.
    </p>
</div>

@if (TempData["ResumeError"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (TempData["ResumeSuccess"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

<div asp-validation-summary="All"
     class="text-danger mb-3"
     role="alert"></div>

<p class="text-muted small mb-4">
    Save each entry using its Add or Update button before continuing.
</p>

<!-- EDUCATION -->
<div class="card-clean mb-4">
    <h4 class="mb-3">Education</h4>

    @if (!educations.Any())
    {
        <p class="text-muted">No education details added yet.</p>
    }

    @foreach (var education in educations)
    {
        <div class="border rounded p-3 mb-3">
            <form asp-controller="JobSeeker"
                  asp-action="UpdateEducation"
                  method="post"
                  class="row g-3 resume-date-form">

                <input type="hidden" name="id" value="@education.Id" />
                <input type="hidden" name="resumeId" value="@resume.Id" />

                <div class="col-md-6">
                    <label class="form-label d-block">
                        Institution
                        <input name="institution"
                               value="@education.Institution"
                               class="form-control mt-1"
                               maxlength="200"
                               required />
                    </label>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">
                        Degree
                        <input name="degree"
                               value="@education.Degree"
                               class="form-control mt-1"
                               maxlength="150" />
                    </label>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">
                        Field of study
                        <input name="fieldOfStudy"
                               value="@education.FieldOfStudy"
                               class="form-control mt-1"
                               maxlength="150" />
                    </label>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">
                        Start date
                        <input type="date"
                               name="startDate"
                               value="@(education.StartDate?.ToString("yyyy-MM-dd"))"
                               class="form-control mt-1" />
                    </label>
                </div>

                <div class="col-md-6">
                    <label class="form-label d-block">
                        End / Expected graduation date
                        <input type="date"
                               name="endDate"
                               value="@(education.EndDate?.ToString("yyyy-MM-dd"))"
                               class="form-control mt-1" />
                    </label>
                    <small class="text-muted">
                        Leave blank if ongoing and the completion date is unknown.
                    </small>
                </div>

                <div class="col-12">
                    <button type="submit"
                            class="btn btn-pill btn-ink btn-sm">
                        Update Education
                    </button>
                </div>
            </form>

            <form asp-action="DeleteEducation"
                  method="post"
                  class="mt-2"
                  onsubmit="return confirm('Remove this education entry?');">
                <input type="hidden" name="id" value="@education.Id" />
                <input type="hidden" name="resumeId" value="@resume.Id" />
                <button type="submit"
                        class="btn btn-pill btn-ghost btn-sm text-danger">
                    Remove
                </button>
            </form>
        </div>
    }

    <details class="mt-3" open="@(!educations.Any())">
        <summary class="fw-semibold">+ Add education</summary>

        <form asp-action="AddEducation"
              method="post"
              class="row g-3 mt-2 resume-date-form">

            <input type="hidden" name="resumeId" value="@resume.Id" />

            <div class="col-md-6">
                <label class="form-label d-block">
                    Institution
                    <input name="institution"
                           class="form-control mt-1"
                           placeholder="School, college or university"
                           maxlength="200"
                           required />
                </label>
            </div>

            <div class="col-md-6">
                <label class="form-label d-block">
                    Degree
                    <input name="degree"
                           class="form-control mt-1"
                           placeholder="e.g. BSc"
                           maxlength="150" />
                </label>
            </div>

            <div class="col-md-6">
                <label class="form-label d-block">
                    Field of study
                    <input name="fieldOfStudy"
                           class="form-control mt-1"
                           placeholder="e.g. Computer Science"
                           maxlength="150" />
                </label>
            </div>

            <div class="col-md-6">
                <label class="form-label d-block">
                    Start date
                    <input type="date"
                           name="startDate"
                           class="form-control mt-1" />
                </label>
            </div>

            <div class="col-md-6">
                <label class="form-label d-block">
                    End / Expected graduation date
                    <input type="date"
                           name="endDate"
                           class="form-control mt-1" />
                </label>
                <small class="text-muted">
                    Leave blank if ongoing and the completion date is unknown.
                </small>
            </div>

            <div class="col-12">
                <button type="submit"
                        class="btn btn-pill btn-mint-outline btn-sm">
                    Add Education
                </button>
            </div>
        </form>
    </details>
</div>

