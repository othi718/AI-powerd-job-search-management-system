@model List<AI_powerd_job_search_management_system.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
    var userRoles = (Dictionary<string, IList<string>>)ViewBag.UserRoles;
}

<div class="page-header">
    <h2>Users</h2>
    <p>@Model.Count() total</p>
</div>

<div class="card-clean p-0">
    <table class="table align-middle mb-0">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th class="ps-4">Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th class="pe-4">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var roles = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
                var isLocked = user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.Now;
                <tr>
                    <td class="ps-4 fw-semibold">@user.FullName</td>
                    <td class="text-muted">@user.Email</td>
                    <td>@string.Join(", ", roles)</td>
                    <td>
                        <span class="badge-pill @(isLocked ? "badge-closed" : "badge-open")">
                            @(isLocked ? "Locked" : "Active")
                        </span>
                    </td>
                    <td class="pe-4">
                        @if (!roles.Contains("Admin"))
                        {
                            <form asp-action="ToggleUserLock" asp-route-id="@user.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-pill btn-ghost btn-sm">
                                    @(isLocked ? "Unlock" : "Lock")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
