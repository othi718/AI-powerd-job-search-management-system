@{
    ViewData["Title"] = "Page not found";
    int code = ViewBag.Code ?? 404;
}

<div class="text-center py-5">
    <h1 style="font-size:4rem;">@code</h1>
    <p class="text-muted mb-4">
        @(code == 404 ? "That page doesn't exist." : "Something went wrong.")
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-pill btn-ink">Back to home</a>
</div>