@model List<AI_powerd_job_search_management_system.Models.Company>

@{
    ViewData["Title"] = "Manage Companies";
}

<div class="page-header">
    <h2>Companies</h2>
    <p>@Model.Count(c => !c.IsApproved) pending approval</p>
</div>

<div class="card-clean p-0">
    <table class="table align-middle mb-0">
        <thead>
            <tr class="text-muted small text-uppercase">
                <th class="ps-4">Company</th>
                <th>Website</th>
                <th>Registered</th>
                <th>Status</th>
                <th class="pe-4">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var company in Model)
            {
                <tr>
                    <td class="ps-4 fw-semibold">@company.Name</td>
                    <td class="text-muted">@(company.Website ?? "-")</td>
                    <td class="text-muted">@company.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td>
                        <span class="badge-pill @(company.IsApproved ? "badge-open" : "badge-closed")">
                            @(company.IsApproved ? "Approved" : "Pending")
                        </span>
                    </td>
                    <td class="pe-4">
                        <form asp-action="ToggleCompanyApproval" asp-route-id="@company.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-pill btn-mint-outline btn-sm">
                                @(company.IsApproved ? "Revoke" : "Approve")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>