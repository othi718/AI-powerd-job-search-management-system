@model List<AI_powerd_job_search_management_system.Models.InterviewMessage>
@{
    ViewData["Title"] = "Chat";
    var application = (AI_Powered_Smart_Job_Management_System.Models.JobApplication)ViewBag.Application;
    var currentUserId = (string)ViewBag.CurrentUserId;
}

<a asp-action="Discuss" asp-route-applicationId="@application.Id" class="btn btn-ghost mb-3">&larr; Back to interview details</a>

<div class="page-header">
    <h2>@application.Job?.Title</h2>
</div>

<div class="card-clean mb-3" style="max-height: 400px; overflow-y: auto;">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">No messages yet — say hello.</p>
    }
    else
    {
        @foreach (var m in Model)
        {
            bool isMine = m.SenderUserId == currentUserId;
            <div class="mb-3 @(isMine ? "text-end" : "")">
                <div class="d-inline-block p-2 px-3 rounded" style="background: @(isMine ? "var(--olive-soft)" : "#F7F5EF"); max-width: 75%;">
                    <p class="mb-1">@m.Message</p>
                    <small class="text-muted">@m.Sender?.FullName &middot; @m.SentAt.ToString("dd MMM, h:mm tt")</small>
                </div>
            </div>
        }
    }
</div>

<form asp-action="SendMessage" method="post" class="d-flex gap-2">
    <input type="hidden" name="applicationId" value="@application.Id" />
    <input type="text" name="message" class="form-control" placeholder="Type a message..." required />
    <button type="submit" class="btn btn-pill btn-ink">Send</button>
</form>