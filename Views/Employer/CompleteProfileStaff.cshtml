@model AI_powerd_job_search_management_system.ViewModels.JoinCompanyViewModel
@{
    ViewData["Title"] = "Join a Company";
    var companies = (IEnumerable<dynamic>)ViewBag.Companies;
}

<div class="page-header">
    <h2>Join an existing company</h2>
    <p>Your request will be sent to that company's Owner for approval.</p>
</div>

<div class="card-clean" style="max-width: 480px;">
    <form asp-action="CompleteProfileStaff" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="CompanyId" class="form-label"></label>
            <select asp-for="CompanyId" class="form-select">
                <option value="">-- Select a company --</option>
                @foreach (var c in companies)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <span asp-validation-for="CompanyId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Position" class="form-label"></label>
            <select asp-for="Position" class="form-select">
                <option value="HR">HR</option>
                <option value="Manager">Manager</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="mb-4">
            <label asp-for="JobTitle" class="form-label"></label>
            <input asp-for="JobTitle" class="form-control" placeholder="e.g. HR Executive" />
            <span asp-validation-for="JobTitle" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-pill btn-ink">Send request</button>
    </form>
</div>