@model List<AI_powerd_job_search_management_system.Models.Resume>

@{
    ViewData["Title"] = "My Resumes";
}

<div class="page-header d-flex justify-content-between
            align-items-end flex-wrap gap-2">
    <div>
        <h2>My resumes</h2>
        <p>@Model.Count uploaded</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="JobSeeker"
           asp-action="Profile"
           class="btn btn-pill btn-ghost">
            &larr; My profile
        </a>

        <a asp-controller="JobSeeker"
           asp-action="UploadResume"
           class="btn btn-pill btn-ink">
            + Upload resume
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">
            You haven't uploaded a resume yet.
        </p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th class="ps-4">File</th>
                        <th>Uploaded</th>
                        <th class="pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var resume in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @resume.OriginalFileName
                            </td>

                            <td class="text-muted text-nowrap">
                                @resume.UploadedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="pe-4">
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <a asp-controller="Files"
                                       asp-action="Preview"
                                       asp-route-id="@resume.Id"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-pill btn-mint-outline btn-sm">
                                        <i class="bi bi-eye me-1"></i>
                                        View
                                    </a>

                                    <form asp-controller="JobSeeker"
                                          asp-action="DeleteResume"
                                          asp-route-id="@resume.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this resume?');">
                                        <button type="submit"
                                                class="btn btn-pill btn-ghost btn-sm text-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}