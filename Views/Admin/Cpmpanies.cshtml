@model List<AI_powerd_job_search_management_system.Models.Company>
@{
    ViewData["Title"] = "Manage Companies";
}
<div class="page-header">
    <h2>Manage companies</h2>
    <p>@Model.Count(c => !c.IsApproved) pending &middot; @Model.Count(c => c.IsApproved) approved</p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">No companies registered yet.</p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <table class="table align-middle mb-0 job-table">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">Company</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th class="pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var company in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="job-avatar">@company.Name.Substring(0, 1).ToUpper()</div>
                                <span class="fw-semibold">@company.Name</span>
                            </div>
                        </td>
                        <td class="text-muted">@company.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge-pill @(company.IsApproved ? "badge-open" : "badge-closed")">
                                <span class="status-dot"></span>@(company.IsApproved ? "Approved" : "Pending")
                            </span>
                        </td>
                        <td class="pe-4">
                            <form asp-action="ToggleCompanyApproval" asp-route-id="@company.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-pill btn-sm @(company.IsApproved ? "btn-ghost" : "btn-ink")">
                                    @(company.IsApproved ? "Revoke approval" : "Approve")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}