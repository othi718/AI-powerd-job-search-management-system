@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-header">
    <h2>Admin Dashboard</h2>
    <p>System overview</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card-lg card-hover">
            <div class="stat-icon" style="background:#3b5bdb;">
                <i class="bi bi-people-fill"></i>
            </div>
            <h3 class="mb-0">@ViewBag.TotalUsers</h3>
            <p class="text-muted mb-0">Total users</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-lg card-hover">
            <div class="stat-icon" style="background:#2f9e44;">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <h3 class="mb-0">@ViewBag.TotalJobs</h3>
            <p class="text-muted mb-0">Total jobs</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-lg card-hover">
            <div class="stat-icon" style="background:#f08c00;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <h3 class="mb-0">@ViewBag.PendingCompanies</h3>
            <p class="text-muted mb-0">Pending approval</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card-lg card-hover">
            <div class="stat-icon" style="background:#7048e8;">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <h3 class="mb-0">@ViewBag.TotalApplications</h3>
            <p class="text-muted mb-0">Applications</p>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Companies" class="btn btn-pill btn-ink">
        <i class="bi bi-building me-1"></i> Manage companies
    </a>
    <a asp-action="Users" class="btn btn-pill btn-mint-outline">
        <i class="bi bi-person-gear me-1"></i> Manage users
    </a>
</div>