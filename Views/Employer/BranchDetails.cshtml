@model AI_powerd_job_search_management_system.Models.Branch
@using AI_powerd_job_search_management_system.Models

@{
    ViewData["Title"] = "Branch Details";

    var jobs = ViewBag.Jobs as List<Job> ?? new List<Job>();

    var hasLocation = !string.IsNullOrWhiteSpace(Model.Location);
    var location = Model.Location?.Trim() ?? "";

    var encodedLocation = System.Uri.EscapeDataString(location);

    var mapEmbedUrl =
        $"https://maps.google.com/maps?q={encodedLocation}&z=15&output=embed";

    var mapSearchUrl =
        $"https://www.google.com/maps/search/?api=1&query={encodedLocation}";

    var directionsUrl =
        $"https://www.google.com/maps/dir/?api=1&destination={encodedLocation}";

    var openJobs = jobs.Count(j => j.Status == JobStatus.Open);
    var closedJobs = jobs.Count(j => j.Status == JobStatus.Closed);

    bool canPostJob = ViewBag.CanPostJob is bool allowed && allowed;
}

<div class="page-header d-flex justify-content-between
            align-items-start flex-wrap gap-3">

    <div>
        <a asp-controller="Employer"
           asp-action="Branches"
           class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i>
            Back to branches
        </a>

        <h2 class="mt-3 mb-2">@Model.Name</h2>

        @if (Model.Company != null)
        {
            <p class="mb-2">
                <i class="bi bi-building me-1"></i>
                @Model.Company.Name
            </p>
        }

        <p class="text-muted mb-0">
            <i class="bi bi-geo-alt me-1"></i>
            @(hasLocation ? location : "No location set")
        </p>
    </div>

    @if (canPostJob)
    {
        <a asp-controller="Employer"
           asp-action="CreateJob"
           class="btn btn-pill btn-ink">
            <i class="bi bi-plus-lg me-1"></i>
            Post a job
        </a>
    }
</div>

<!-- JOB SUMMARY -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-clean h-100">
            <p class="text-muted small mb-2">
                <i class="bi bi-briefcase me-1"></i>
                Total jobs posted
            </p>
            <h3 class="mb-0">@jobs.Count</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-clean h-100">
            <p class="text-muted small mb-2">
                <i class="bi bi-check-circle me-1"></i>
                Open jobs
            </p>
            <h3 class="mb-0">@openJobs</h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-clean h-100">
            <p class="text-muted small mb-2">
                <i class="bi bi-lock me-1"></i>
                Closed jobs
            </p>
            <h3 class="mb-0">@closedJobs</h3>
        </div>
    </div>
</div>

<!-- BRANCH INFORMATION AND MAP -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card-clean h-100">
            <h4 class="mb-4">Branch information</h4>

            <div class="mb-4">
                <p class="text-muted small mb-1">Branch name</p>
                <div class="fw-semibold">@Model.Name</div>
            </div>

            @if (Model.Company != null)
            {
                <div class="mb-4">
                    <p class="text-muted small mb-1">Company</p>
                    <div class="fw-semibold">@Model.Company.Name</div>
                </div>
            }

            <div class="mb-4">
                <p class="text-muted small mb-1">Address / Location</p>
                <div>
                    @(hasLocation ? location : "No location provided.")
                </div>
            </div>

            <div class="mb-4">
                <p class="text-muted small mb-1">Branch added</p>
                <div>@Model.CreatedAt.ToString("dd MMM yyyy")</div>
            </div>

            @if (hasLocation)
            {
                <div class="d-flex flex-wrap gap-2">
                    <a href="@mapSearchUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-pill btn-mint-outline btn-sm">
                        <i class="bi bi-map me-1"></i>
                        Open Google Maps
                    </a>

                    <a href="@directionsUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-pill btn-ghost btn-sm">
                        <i class="bi bi-signpost-2 me-1"></i>
                        Get directions
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card-clean p-0 h-100 overflow-hidden">
            <div class="p-4 border-bottom">
                <h4 class="mb-1">Branch location</h4>
                <p class="text-muted mb-0">
                    Find @Model.Name on the map.
                </p>
            </div>

            @if (hasLocation)
            {
                <iframe src="@mapEmbedUrl"
                        title="Map showing the location of @Model.Name"
                        width="100%"
                        height="380"
                        style="border: 0; display: block;"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen>
                </iframe>
            }
            else
            {
                <div class="d-flex flex-column justify-content-center
                            align-items-center text-center p-4"
                     style="min-height: 380px;">
                    <i class="bi bi-geo-alt fs-1 text-muted mb-3"></i>
                    <h5>Location not available</h5>
                    <p class="text-muted mb-0">
                        No address has been provided for this branch.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- BRANCH JOBS -->
<div class="card-clean p-0 mb-4">
    <div class="p-4 border-bottom">
        <h4 class="mb-1">Branch jobs</h4>
        <p class="text-muted mb-0">
            Jobs posted under @Model.Name.
        </p>
    </div>

    @if (!jobs.Any())
    {
        <div class="text-center py-5 px-3">
            <i class="bi bi-briefcase fs-1 text-muted d-block mb-3"></i>
            <p class="text-muted mb-0">
                No jobs have been posted for this branch.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th class="ps-4">Job title</th>
                        <th>Location</th>
                        <th>Posted by</th>
                        <th>Status</th>
                        <th>Posted</th>
                        <th class="pe-4">Deadline</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var job in jobs)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @job.Title
                            </td>

                            <td class="text-muted">
                                @(string.IsNullOrWhiteSpace(job.Location)
                                    ? "Not specified"
                                    : job.Location)
                            </td>

                            <td>
                                @(job.Employer?.ApplicationUser?.FullName
                                    ?? "Not available")
                            </td>

                            <td>
                                <span class="badge-pill @(job.Status == JobStatus.Open
                                    ? "badge-open"
                                    : "badge-closed")">
                                    <span class="status-dot"></span>
                                    @job.Status
                                </span>
                            </td>

                            <td class="text-muted text-nowrap">
                                @job.PostedAt.ToString("dd MMM yyyy")
                            </td>

                            <td class="pe-4 text-muted text-nowrap">
                                @(job.Deadline?.ToString("dd MMM yyyy")
                                    ?? "Not specified")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>