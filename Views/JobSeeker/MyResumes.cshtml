@model List<AI_powerd_job_search_management_system.Models.Resume>

@{
    ViewData["Title"] = "My Resumes";
}

<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>My resumes</h2>
        <p>@Model.Count() uploaded</p>
    </div>
    <a asp-action="UploadResume" class="btn btn-pill btn-ink">+ Upload resume</a>
</div>

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">You haven't uploaded a resume yet.</p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">File</th>
                    <th>Uploaded</th>
                    <th class="pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resume in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@resume.OriginalFileName</td>
                        <td class="text-muted">@resume.UploadedAt.ToString("dd MMM yyyy")</td>
                        <td class="pe-4">
                            <form asp-action="DeleteResume" asp-route-id="@resume.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this resume?');">
                                <button type="submit" class="btn btn-pill btn-ghost btn-sm text-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}