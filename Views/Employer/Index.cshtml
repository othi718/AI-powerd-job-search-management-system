@model List<AI_powerd_job_search_management_system.Models.Job>

@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>Your job postings</h2>
        <p>@Model.Count() posted &middot; @Model.Count(j => j.Status == AI_powerd_job_search_management_system.Models.JobStatus.Open) open</p>
    </div>
    <a asp-action="CreateJob" class="btn btn-pill btn-ink">+ Post a new job</a>
</div>

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">You haven't posted any jobs yet.</p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">Title</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Posted</th>
                    <th>Applicants</th>
                    <th class="pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@job.Title</td>
                        <td class="text-muted">@job.Location</td>
                        <td>
                            <span class="badge-pill @(job.Status == AI_powerd_job_search_management_system.Models.JobStatus.Open ? "badge-open" : "badge-closed")">
                                @job.Status
                            </span>
                        </td>
                        <td class="text-muted">@job.PostedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-muted">@job.Applications.Count</td>
                        <td class="pe-4">
                            <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-pill btn-mint-outline btn-sm">Edit</a>
                            <a asp-action="Applicants" asp-route-jobId="@job.Id" class="btn btn-pill btn-ghost btn-sm">Applicants (@job.Applications.Count)</a>
                            <form asp-action="ToggleStatus" asp-route-id="@job.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-pill btn-ghost btn-sm">
                                    @(job.Status == AI_powerd_job_search_management_system.Models.JobStatus.Open ? "Close" : "Reopen")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}