@model AI_powerd_job_search_management_system.ViewModels.ResumeUploadViewModel

@{
    ViewData["Title"] = "Upload Resume";
}

<div class="page-header">
    <h2>Upload your resume</h2>
    <p>Choose a PDF or DOCX file, up to 5 MB.</p>
</div>

<div class="card-clean" style="max-width: 560px;">
    @if (Model.ResumeId.HasValue)
    {
        <p class="text-muted mb-4">
            Your saved education, experience and other details
            will stay linked to this resume.
        </p>
    }

    <form asp-controller="JobSeeker"
          asp-action="UploadResume"
          method="post"
          enctype="multipart/form-data">

        <input asp-for="ResumeId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-3"></div>

        <div class="mb-4">
            <label asp-for="File" class="form-label"></label>

            <input asp-for="File"
                   type="file"
                   class="form-control"
                   accept=".pdf,.docx" />

            <span asp-validation-for="File"
                  class="text-danger small"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-pill btn-ink">
                Upload and view profile
            </button>

            @if (Model.ResumeId.HasValue)
            {
                <a asp-action="ResumeDetails"
                   asp-route-resumeId="@Model.ResumeId"
                   class="btn btn-pill btn-ghost">
                    Back to details
                </a>
            }
            else
            {
                <a asp-action="MyResumes"
                   class="btn btn-pill btn-ghost">
                    Cancel
                </a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}