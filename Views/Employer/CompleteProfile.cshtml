@{
    ViewData["Title"] = "Complete Your Profile";
}

<div class="page-header">
    <h2>How are you joining SmartHire?</h2>
    <p>Choose the option that matches your situation.</p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card-clean h-100">
            <h5>I'm registering a new company</h5>
            <p class="text-muted">You'll be the company's Owner — set up company details and wait for Admin approval.</p>
            <a asp-action="CompleteProfileOwner" class="btn btn-pill btn-ink">Register as Owner</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-clean h-100">
            <h5>I'm joining an existing company</h5>
            <p class="text-muted">Join as HR, Manager, or Other staff — your company's Owner will approve you.</p>
            <a asp-action="CompleteProfileStaff" class="btn btn-pill btn-mint-outline">Join as Staff</a>
        </div>
    </div>
</div>