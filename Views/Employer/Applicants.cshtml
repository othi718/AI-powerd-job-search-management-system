@model List<AI_powerd_job_search_management_system.Models.JobApplication>
@using AI_powerd_job_search_management_system.Models

@{
    ViewData["Title"] = "Applicants";
    var job = (Job)ViewBag.Job;
}

<div class="page-header">
    <h2>Applicants for @job.Title</h2>
    <p>@Model.Count applicant(s)</p>
</div>

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">No applicants yet.</p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th class="ps-4">Name</th>
                        <th>Email</th>
                        <th>Resume</th>
                        <th>Applied</th>
                        <th>Match</th>
                        <th>Status</th>
                        <th class="pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">
                                @app.JobSeeker?.ApplicationUser?.FullName
                            </td>

                            <td class="text-muted">
                                @app.JobSeeker?.ApplicationUser?.Email
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Files"
                                       asp-action="Preview"
                                       asp-route-id="@app.ResumeId"
                                       target="_blank"
                                       rel="noopener"
                                       class="btn btn-pill btn-mint-outline btn-sm">
                                        View
                                    </a>

                                    <a asp-controller="Files"
                                       asp-action="DownloadResume"
                                       asp-route-id="@app.ResumeId"
                                       class="btn btn-pill btn-ghost btn-sm">
                                        Download
                                    </a>
                                </div>
                            </td>

                            <td class="text-muted text-nowrap">
                                @app.AppliedAt.ToString("dd MMM yyyy")
                            </td>

                            <td style="min-width: 200px; max-width: 320px;">
                                <strong>@app.MatchScore.ToString("0.#")%</strong>

                                @if (app.AIAnalysis != null)
                                {
                                    @if (!string.IsNullOrWhiteSpace(
                                                            app.AIAnalysis.MissingSkills))
                                    {
                                        <div class="small text-muted mt-1">
                                            Missing: @app.AIAnalysis.MissingSkills
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                                            app.AIAnalysis.AIInsight))
                                    {
                                        <details class="small mt-2">
                                            <summary>AI insight</summary>
                                            <div class="mt-2"
                                                 style="white-space: pre-line;">
                                                @app.AIAnalysis.AIInsight
                                            </div>
                                        </details>
                                    }
                                }
                            </td>

                            <td>
                                <form asp-controller="Employer"
                                      asp-action="UpdateApplicationStatus"
                                      method="post"
                                      class="d-flex align-items-center gap-2">

                                    <input type="hidden"
                                           name="applicationId"
                                           value="@app.Id" />

                                    <select name="status"
                                            aria-label="Application status"
                                            class="form-select form-select-sm"
                                            style="min-width: 130px;">
                                        @foreach (var status in Enum.GetValues<ApplicationStatus>())
                                        {
                                            <option value="@status"
                                                    selected="@(status == app.Status)">
                                                @status
                                            </option>
                                        }
                                    </select>

                                    <button type="submit"
                                            class="btn btn-pill btn-ghost btn-sm">
                                        Update
                                    </button>
                                </form>
                            </td>

                            <td class="pe-4">
                                <div class="d-flex flex-wrap gap-2"
                                     style="min-width: 190px;">

                                    <a asp-controller="Employer"
                                       asp-action="ApplicantDetails"
                                       asp-route-applicationId="@app.Id"
                                       class="btn btn-pill btn-mint-outline btn-sm">
                                        Details
                                    </a>

                                    <a asp-controller="Employer"
                                       asp-action="ScheduleInterview"
                                       asp-route-applicationId="@app.Id"
                                       class="btn btn-pill btn-mint-outline btn-sm">
                                        Interview
                                    </a>

                                    <a asp-controller="Messages"
                                       asp-action="Discuss"
                                       asp-route-applicationId="@app.Id"
                                       class="btn btn-pill btn-ghost btn-sm">
                                        Discuss
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}