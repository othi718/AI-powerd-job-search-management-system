@{
    var company = (AI_powerd_job_search_management_system.Models.Company)ViewBag.Company;
    var jobs = (List<AI_powerd_job_search_management_system.Models.Job>)ViewBag.Jobs;
    var reviews = (List<AI_powerd_job_search_management_system.Models.CompanyReview>)ViewBag.Reviews;
    var topSkills = ViewBag.TopSkills;
    ViewData["Title"] = company.Name;
}
<div class="card-clean mb-4">
    <h5 class="mb-3">Branches</h5>
    @{
        var branches = (List<AI_powerd_job_search_management_system.Models.Branch>)ViewBag.Branches;
        var mainBranch = branches.OrderBy(b => b.Id).FirstOrDefault();
        var otherBranches = branches.Where(b => b != mainBranch).ToList();
    }
    @if (!branches.Any())
    {
        <p class="text-muted mb-0">No branch information available.</p>
    }
    else
    {
        @if (mainBranch != null)
        {
            <div class="p-3 rounded mb-3" style="background:#F7F5EF;">
                <strong>@mainBranch.Name</strong>
                <div class="text-muted small mb-2">@(mainBranch.Location ?? "Location not set")</div>
                @if (!string.IsNullOrWhiteSpace(mainBranch.Location))
                {
                    <iframe width="100%" height="220" style="border:0; border-radius:10px;"
                            loading="lazy"
                            src="https://www.google.com/maps?q=@Uri.EscapeDataString(mainBranch.Location)&output=embed">
                    </iframe>
                }
            </div>
        }

        <div class="row g-2">
            @foreach (var b in otherBranches)
            {
                var mapId = $"map-{b.Id}";
                <div class="col-md-4">
                    <div class="p-2 rounded position-relative" style="background:#F7F5EF;">
                        @if (!string.IsNullOrWhiteSpace(b.Location))
                        {
                            <button type="button" class="btn btn-sm position-absolute" style="top:6px; right:6px; padding:2px 6px;"
                                    onclick="document.getElementById('@mapId').classList.toggle('d-none')" title="Show location">
                                &#128205;
                            </button>
                        }
                        <strong>@b.Name</strong>
                        <div class="text-muted small">@(b.Location ?? "Location not set")</div>
                        @if (!string.IsNullOrWhiteSpace(b.Location))
                        {
                            <iframe id="@mapId"
                                    class="d-none mt-2"
                                    width="100%" height="180" style="border:0; border-radius:8px;"
                                    loading="lazy"
                                    src="https://www.google.com/maps?q=@Uri.EscapeDataString(b.Location)&output=embed">
                            </iframe>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="card-clean mb-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h2 class="mb-1">@company.Name</h2>
            <p class="text-muted mb-1">@company.Location</p>
            @if (!string.IsNullOrWhiteSpace(company.Website))
            {
                <a href="@company.Website" target="_blank">@company.Website</a>
            }
        </div>
        <div class="text-end">
            <p class="mb-1"><strong>@ViewBag.FollowerCount</strong> followers</p>
            @if (User.Identity!.IsAuthenticated && User.IsInRole("JobSeeker"))
            {
                <form asp-action="ToggleFollow" method="post">
                    <input type="hidden" name="companyId" value="@company.Id" />
                    <button type="submit" class="btn btn-pill @(ViewBag.IsFollowing == true ? "btn-mint-outline" : "btn-ink")">
                        @(ViewBag.IsFollowing == true ? "Following" : "+ Follow")
                    </button>
                </form>
            }
        </div>
    </div>
    <p class="mt-3 text-muted">@(company.Description ?? "No description provided.")</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-clean text-center"><h3 class="mb-0">@jobs.Count</h3><p class="text-muted mb-0">Open jobs</p></div>
    </div>
    <div class="col-md-3">
        <div class="card-clean text-center"><h3 class="mb-0">@ViewBag.TotalApplications</h3><p class="text-muted mb-0">Total applicants</p></div>
    </div>
   
    <div class="col-md-3">
        <div class="card-clean text-center"><h3 class="mb-0">@ViewBag.AvgRating &#9733;</h3><p class="text-muted mb-0">@reviews.Count reviews</p></div>
    </div>
</div>

@if (((IEnumerable<dynamic>)topSkills).Any())
{
    <div class="card-clean mb-4">
        <h5 class="mb-3">Top skills this company is hiring for</h5>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var s in topSkills)
            {
                <span class="badge-pill badge-open">@s.Skill (@s.Count)</span>
            }
        </div>
    </div>
}

<div class="card-clean mb-4">
    <h5 class="mb-3">Open positions</h5>
    @if (!jobs.Any())
    {
        <p class="text-muted mb-0">No open jobs right now.</p>
    }
    else
    {
        @foreach (var job in jobs)
        {
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div>
                    <strong>@job.Title</strong>
                    <div class="text-muted small">@job.Location &middot; @job.Category</div>
                </div>
                <a asp-controller="JobSeeker" asp-action="Details" asp-route-id="@job.Id" class="btn btn-pill btn-mint-outline btn-sm">View</a>
            </div>
        }
    }
</div>

<div class="card-clean">
    <h5 class="mb-3">Reviews</h5>

    @if (User.Identity!.IsAuthenticated && User.IsInRole("JobSeeker") && ViewBag.HasReviewed != true)
    {
        <form asp-action="AddReview" method="post" class="mb-4">
            <input type="hidden" name="companyId" value="@company.Id" />
            <div class="mb-2">
                <label class="form-label">Your rating</label>
                <select name="rating" class="form-select" style="max-width:160px;">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Very poor</option>
                </select>
            </div>
            <div class="mb-2">
                <textarea name="comment" class="form-control" rows="2" placeholder="Share your experience (optional)"></textarea>
            </div>
            <button type="submit" class="btn btn-pill btn-ink btn-sm">Submit review</button>
        </form>
    }

    @if (!reviews.Any())
    {
        <p class="text-muted mb-0">No reviews yet.</p>
    }
    else
    {
        @foreach (var r in reviews)
        {
            <div class="py-2 border-bottom">
                <strong>@string.Concat(Enumerable.Repeat("★", r.Rating))</strong>
                <span class="text-muted small">&middot; @r.JobSeekerUser?.FullName &middot; @r.CreatedAt.ToString("dd MMM yyyy")</span>
                @if (!string.IsNullOrWhiteSpace(r.Comment))
                {
                    <p class="mb-0">@r.Comment</p>
                }
            </div>
        }
    }
</div>