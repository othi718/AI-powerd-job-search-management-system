@model AI_powerd_job_search_management_system.Models.JobSeeker

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>My Profile</h2>
        <p>How employers see you</p>
    </div>

    <a asp-action="EditProfile"
       class="btn btn-pill btn-mint-outline">
        Edit profile
    </a>
</div>

<div class="card-clean" style="max-width: 640px;">

    <h4 class="mb-1">
        @ViewBag.FullName
    </h4>

    <p class="text-muted mb-4">
        @ViewBag.Email
    </p>

    <p>
        <strong>Location:</strong>
        @(Model.Location ?? "Not set")
    </p>

    <h5 class="mt-4">Bio</h5>

    <p class="text-muted"
       style="white-space: pre-wrap;">
        @(Model.Bio ?? "No bio added yet.")
    </p>

    <hr />

    <div class="d-flex justify-content-between align-items-center">

        <h5>My Skills</h5>

        <a asp-action="Skills"
           class="btn btn-sm btn-ink">
            Manage Skills
        </a>

    </div>

    <div class="mt-3">

        @if (Model.Skills != null && Model.Skills.Any())
        {
            <div class="d-flex flex-wrap gap-2">

                @foreach (var skill in Model.Skills)
                {
                    <span class="badge bg-dark rounded-pill px-3 py-2">
                        @skill.Skill?.Name
                    </span>
                }

            </div>
        }
        else
        {
            <p class="text-muted">
                No skills added yet.
            </p>
        }
        @{
            var resume = (AI_powerd_job_search_management_system.Models.Resume?)ViewBag.ActiveResume;
        }
        <hr />
        @if (resume == null)
        {
            <p class="text-muted mb-0">No resume uploaded yet.</p>
        }
        else
        {
            <div class="d-flex gap-2 mb-3">

                <a asp-action="ResumeDetails" asp-route-resumeId="@resume.Id" class="btn btn-pill btn-ink btn-sm">+ Add Education / Experience / Certificates</a>
            </div>

            @if (resume.Educations.Any())
            {
                <h5>Education</h5>
                @foreach (var e in resume.Educations)
                {
                    <p class="mb-1"><strong>@e.Institution</strong> — @e.Degree @(e.FieldOfStudy != null ? $"in {e.FieldOfStudy}" : "")</p>
                }
            }
            @if (resume.Experiences.Any())
            {
                <h5 class="mt-3">Experience</h5>
                @foreach (var e in resume.Experiences)
                {
                    <p class="mb-1"><strong>@e.JobTitle</strong> at @e.CompanyName</p>
                }
            }
            @if (resume.Certifications.Any())
            {
                <h5 class="mt-3">Certifications</h5>
                @foreach (var c in resume.Certifications)
                {
                    <p class="mb-1">@c.Name — @c.IssuingOrganization</p>
                }
            }
            @if (resume.Projects.Any())
            {
                <h5 class="mt-3">Projects</h5>
                @foreach (var p in resume.Projects)
                {
                    <p class="mb-1"><strong>@p.Title</strong> — @p.TechnologiesUsed</p>
                }
            }
            @if (resume.ExtracurricularActivities.Any())
            {
                <h5 class="mt-3">Extracurricular Activities</h5>
                @foreach (var a in resume.ExtracurricularActivities)
                {
                    <p class="mb-1">@a.ActivityName — @a.RoleOrPosition</p>
                }
            }
        }

    </div>

    <hr />

    <a asp-action="MyResumes"
       class="btn btn-pill btn-ink">
        Manage resumes
    </a>

</div>