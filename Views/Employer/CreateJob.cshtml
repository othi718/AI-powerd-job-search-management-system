@model AI_powerd_job_search_management_system.ViewModels.JobViewModel

@{
    ViewData["Title"] = "Post a New Job";
}

<div class="page-header">
    <h2>Post a new job</h2>
    <p>This will appear immediately in job seekers' search results.</p>
</div>

<div class="card-clean" style="max-width: 640px;">
    <form asp-action="CreateJob" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select">
                <option value="">-- Select category --</option>
                @foreach (var c in AI_powerd_job_search_management_system.Utilities.JobCategories.All)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <span asp-validation-for="Category" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="mb-3"><label class="form-label">Education Requirement</label><input asp-for="EducationRequirement" class="form-control" placeholder="e.g. Bachelor's in CSE" /></div>
        <div class="mb-3"><label class="form-label">Experience Requirement</label><input asp-for="ExperienceRequirement" class="form-control" placeholder="e.g. At least 2 years" /></div>
        <div class="mb-3"><label class="form-label">Additional Requirements</label><textarea asp-for="AdditionalRequirements" class="form-control" rows="2"></textarea></div>
        <div class="mb-3"><label class="form-label">Responsibilities</label><textarea asp-for="Responsibilities" class="form-control" rows="3"></textarea></div>
        <div class="mb-3"><label class="form-label">Benefits</label><textarea asp-for="Benefits" class="form-control" rows="2" placeholder="e.g. Health insurance, festival bonus"></textarea></div>
        <div class="mb-3">
            <label asp-for="RequiredSkills" class="form-label"></label>

            <input asp-for="RequiredSkills"
                   class="form-control"
                   placeholder="C#, ASP.NET Core, SQL Server, Entity Framework" />

            <small class="text-muted">
                Enter skills separated by commas.
            </small>

            <span asp-validation-for="RequiredSkills"
                  class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Branch</label>
            <select asp-for="BranchId" class="form-select">
                @foreach (var b in (List<AI_powerd_job_search_management_system.Models.Branch>)ViewBag.Branches)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
        </div>

        <div class="mb-4">
            <label asp-for="SalaryRange" class="form-label"></label>
            <input asp-for="SalaryRange" class="form-control" />
        </div>
        <div class="mb-4">
            <label asp-for="Deadline" class="form-label"></label>
            <input asp-for="Deadline" class="form-control" />
        </div>

        <button type="submit" class="btn btn-pill btn-ink">Post job</button>
        <a asp-action="Index" class="btn btn-ghost">Cancel</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}