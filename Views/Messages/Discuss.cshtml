@{
    ViewData["Title"] = "Discuss";
    var application = (AI_Powered_Smart_Job_Management_System.Models.JobApplication)ViewBag.Application;
    int unread = ViewBag.UnreadCount;
}

<div class="page-header">
    <h2>@application.Job?.Title</h2>
    <p>Discussion about this application</p>
</div>

@if (application.Interview != null)
{
    <div class="card-clean mb-4">
        <h5 class="mb-2">Interview details</h5>
        <p class="mb-1"><strong>When:</strong> @application.Interview.ScheduledAt.ToString("dd MMM yyyy, h:mm tt")</p>
        <p class="mb-1"><strong>Where:</strong> @(application.Interview.Location ?? "Not specified")</p>
        @if (!string.IsNullOrWhiteSpace(application.Interview.Notes))
        {
            <p class="mb-0"><strong>Notes:</strong> @application.Interview.Notes</p>
        }
    </div>
}

<div class="card-clean d-flex justify-content-between align-items-center">
    <div>
        <h5 class="mb-1">Have a question?</h5>
        <p class="text-muted mb-0">Ask if you need to know anything more before the interview.</p>
    </div>
    <a asp-action="Chat" asp-route-applicationId="@application.Id" class="position-relative d-inline-flex align-items-center" title="Open chat">
        <span style="font-size:1.75rem;">&#128172;</span>
        @if (unread > 0)
        {
            <span class="position-absolute badge rounded-pill bg-danger" style="top:-6px; right:-10px; font-size:0.65rem;">@unread</span>
        }
    </a>
</div>