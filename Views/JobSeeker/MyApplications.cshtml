@model List<AI_Powered_Smart_Job_Management_System.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
}

<div class="page-header">
    <h2>My applications</h2>
    <p>@Model.Count() submitted</p>
</div>

@if (!Model.Any())
{
    <div class="card-clean text-center py-5">
        <p class="mb-0 text-muted">You haven't applied to any jobs yet.</p>
    </div>
}
else
{
    <div class="card-clean p-0">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">Job</th>
                    <th>Company</th>
                    <th>Applied</th>
                    <th>Match</th>
                    <th class="pe-4">Status</th>
                    <th>Edit</th>
                  
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">@app.Job?.Title</td>
                        <td class="text-muted">@app.Job?.Employer?.Company?.Name</td>
                        <td class="text-muted">@app.AppliedAt.ToString("dd MMM yyyy")</td>
                        <td>@app.MatchScore%</td>
                        <td class="pe-4">
                            <span class="badge-pill @(app.Status == AI_Powered_Smart_Job_Management_System.Models.ApplicationStatus.Accepted ? "badge-open" : "badge-closed")">
                                @app.Status
                            </span>
                        </td>
                        <td>
                            @if ((DateTime.UtcNow - app.AppliedAt).TotalHours <= 24)
                            {
                                <a asp-action="EditApplication" asp-route-id="@app.Id" class="btn btn-pill btn-ghost btn-sm">Edit</a>
                            <td><a asp-controller="Messages" asp-action="Discuss" asp-route-applicationId="@app.Id" class="btn btn-pill btn-ghost btn-sm">Discuss</a></td>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
