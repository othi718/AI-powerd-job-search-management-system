@model AI_powerd_job_search_management_system.Models.JobSeeker

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h2>My Profile</h2>
        <p>How employers see you</p>
    </div>
    <a asp-action="EditProfile" class="btn btn-pill btn-mint-outline">Edit profile</a>
</div>

<div class="card-clean" style="max-width: 560px;">
    <h4 class="mb-1">@ViewBag.FullName</h4>
    <p class="text-muted mb-4">@ViewBag.Email</p>

    <p><strong>Location:</strong> @(Model.Location ?? "Not set")</p>

    <h5 class="mt-4">Bio</h5>
    <p class="text-muted" style="white-space: pre-wrap;">@(Model.Bio ?? "No bio added yet.")</p>

    <hr />
    <a asp-action="MyResumes" class="btn btn-pill btn-ink">Manage resumes</a>
</div>